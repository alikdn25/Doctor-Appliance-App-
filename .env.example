APP_NAME="Doctor Appliance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=field_service
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk for public media (brand logos). Use "s3" once object storage is chosen.
MEDIA_DISK=public
# Disk for private media (job photos, signatures, rating plates); served only through authorized routes.
PRIVATE_MEDIA_DISK=local
# Queue and cache: "database" needs nothing beyond PostgreSQL and is enough for small teams. Switch both to "redis"
# (and run redis-server) when the load grows — see docs/DEPLOYMENT.md §5.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Estimates and invoices are emailed from this address (a domain verified at the mail provider) with the
# brand's sender name; customer replies go to the brand's sender/email address.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Set for S3-compatible providers (e.g. Contabo, Wasabi, DigitalOcean Spaces)
AWS_ENDPOINT=
AWS_URL=

# Two-factor authentication is optional and enabled individually in Security settings.
# Enable only after a real email arrives and the queue worker is checked.
# Until then, signup and existing company logins do not require an email link.
AUTH_EMAIL_DELIVERY_ENABLED=false
AUTH_EMAIL_VERIFICATION_REQUIRED=true
# Minutes a password reset / invitation link stays valid.
AUTH_PASSWORD_RESET_EXPIRE=1440

# Temporary: sign every visitor in as this account, with no password or code. Leave empty for normal sign-in.
AUTH_AUTO_LOGIN_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Time zone database file read when PHP uses the system tzdata (super-admin age check)
TZDATA_ZONEINFO_FILE=/usr/share/zoneinfo/tzdata.zi

# Square (SPEC §7.6). One Square application for the platform; each company connects its own Square
# account by OAuth from Company settings. Use "sandbox" with the sandbox app credentials while testing.
# OAuth redirect URL to register in the Square dashboard: ${APP_URL}/payment-providers/square/callback
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Webhook subscription (payment.created, payment.updated, refund.created, refund.updated, oauth.authorization.revoked):
# URL ${APP_URL}/webhooks/payments/square — enter the same URL below; it is part of the signature.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_API_VERSION=2025-10-16

# Google Places address autocomplete on customer addresses (Maps JavaScript API + Places API (New)).
# Browser key: restrict it to your domain (HTTP referrers) and to those APIs. Leave empty to type addresses by hand.
GOOGLE_MAPS_BROWSER_KEY=
# JavaScript map ID for the calendar map; replace the demo ID for production.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Country preselected when the super-admin creates a company.
DEFAULT_COMPANY_COUNTRY=US

# Twilio (SPEC §7.7): the platform's master account. Each company in "Automatic" SMS mode gets a subaccount and a
# local number under it from Messaging settings. Incoming SMS: ${APP_URL}/webhooks/sms/twilio (set automatically).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Local hour (company time zone) when the day-before visit reminders go out.
SMS_REMINDER_HOUR=17
