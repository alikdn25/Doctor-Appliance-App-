APP_NAME="Doctor Appliance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=field_service
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk for public media (brand logos). Use "s3" once object storage is chosen.
MEDIA_DISK=public
# Minutes from full payment to the one Google review reminder (no click on a review link). 1440 = 24 hours.
REVIEW_REMINDER_DELAY_MINUTES=1440
# Disk for private media (job photos, signatures, rating plates); served only through authorized routes.
PRIVATE_MEDIA_DISK=local
# Queue and cache: "database" needs nothing beyond PostgreSQL and is enough for small teams. Switch both to "redis"
# (and run redis-server) when the load grows — see docs/DEPLOYMENT.md §5.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Estimates and invoices are emailed from this address (a domain verified at the mail provider) with the
# brand's sender name; customer replies go to the brand's sender/email address.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Where replies go when the company has no email in its settings (and for password resets, confirmations).
MAIL_REPLY_TO_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Set for S3-compatible providers (e.g. Contabo, Wasabi, DigitalOcean Spaces)
AWS_ENDPOINT=
AWS_URL=

# Two-factor authentication is optional and enabled individually in Security settings.
# Enable only after a real email arrives and the queue worker is checked.
# Until then, signup and existing company logins do not require an email link.
AUTH_EMAIL_DELIVERY_ENABLED=false
AUTH_EMAIL_VERIFICATION_REQUIRED=true
# Minutes a password reset / invitation link stays valid.
AUTH_PASSWORD_RESET_EXPIRE=1440

# Page data in the browser history is encrypted and cleared on sign-out, so Back never shows another
# person's data on a shared phone (needs HTTPS, or localhost in development).
INERTIA_ENCRYPT_HISTORY=true

VITE_APP_NAME="${APP_NAME}"

# Time zone database file read when PHP uses the system tzdata (super-admin age check)
TZDATA_ZONEINFO_FILE=/usr/share/zoneinfo/tzdata.zi

# Square (SPEC §7.6). One Square application for the platform; each company connects its own Square
# account by OAuth from Company settings. Use "sandbox" with the sandbox app credentials while testing.
# OAuth redirect URL to register in the Square dashboard: ${APP_URL}/payment-providers/square/callback
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Webhook subscription (payment.created, payment.updated, refund.created, refund.updated, oauth.authorization.revoked):
# URL ${APP_URL}/webhooks/payments/square — enter the same URL below; it is part of the signature.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_API_VERSION=2025-10-16
# Push to the Android app (Firebase Cloud Messaging, docs/ANDROID.md): the Firebase service account key JSON,
# base64-encoded on one line (base64 -w0 key.json). Empty = only browser / PWA push.
FCM_SERVICE_ACCOUNT_BASE64=
# Android app (docs/ANDROID.md): the APK built by GitHub Actions is served from this file at /download/android.apk;
# its version is read from android.json next to it (page /android, "Update available" in the app). Empty = default
# storage/app/android/android.apk.
ANDROID_APK_PATH=

# Google Places address autocomplete on customer addresses (Maps JavaScript API + Places API (New)).
# Browser key: restrict it to your domain (HTTP referrers) and to those APIs. Leave empty to type addresses by hand.
GOOGLE_MAPS_BROWSER_KEY=
# JavaScript map ID for the calendar map; replace the demo ID for production.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Optional server key (Geocoding API + Distance Matrix API, restricted to the server IP): map positions for
# addresses typed by hand, and road distances of the trips in the mileage log (without it, distances are typed).
# After setting it, run `php artisan properties:geocode` once for addresses saved earlier.
GOOGLE_MAPS_SERVER_KEY=
# Default service area for Company → Service area → "Reset to default": south,north,west,east in degrees. Address
# suggestions are limited to a company's box. Empty = no box (suggestions anywhere in the company's country).
# Example (Lower Mainland, BC): 49.00,49.50,-123.35,-121.30
GOOGLE_PLACES_DEFAULT_SERVICE_AREA=

# Nightly backup to Google Drive (Settings → Morning SMS & backup → Connect Google Drive). A Google Cloud OAuth client
# (Web application, Drive API enabled), redirect URI {APP_URL}/settings/google-drive/callback. Empty = off.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Country preselected when the super-admin creates a company.
DEFAULT_COMPANY_COUNTRY=US

# SMS provider for new numbers (SPEC §7.7): telnyx (default) or twilio. A company keeps the provider its number
# came from, so both can be configured at the same time.
SMS_PROVIDER=telnyx
# Telnyx: API key (Portal → Keys & Credentials → API Keys) and the account's webhook public key (… → Public Key).
# Each company in "Automatic" mode gets a messaging profile and a local number from Messaging settings.
# Incoming SMS: ${APP_URL}/webhooks/sms/telnyx (set on the profile automatically); delivery: …/telnyx/status.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Missed-call auto text: calls to company numbers go through a Telnyx voice app with the webhook
# https://<app>/webhooks/voice/telnyx. Leave false until that is set up.
TELNYX_VOICE_ENABLED=false
# Twilio (optional, for numbers taken at Twilio): the platform's master account with a subaccount per company.
# AI (Anthropic API, config/ai.php). Every AI request goes through one service and is logged (tokens, cost, time).
# Each feature always uses its own model; there is no switching between models. Empty key = AI features are off
# ("Paste from message" falls back to the basic parser, Quick booking says the AI is not available).
ANTHROPIC_API_KEY=
# Reading the text of a booking (Quick booking, Paste from message).
AI_MODEL_BOOKING=claude-haiku-5-5
# The assistant and Find problems.
AI_MODEL_ASSISTANT=claude-sonnet-5-5
# App review only.
AI_MODEL_REVIEW=claude-opus-5-5
# AI requests one company may make per day (its own time zone).
AI_DAILY_LIMIT_PER_COMPANY=200

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Local hour (company time zone) when the day-before visit reminders go out.
SMS_REMINDER_HOUR=17

# --- Data protection (docs/RESTORE.md) ---
# Encryption key of the backups: php artisan backup:key. Keep a copy OUTSIDE the server (password manager):
# without it no backup can be read.
BACKUP_ENCRYPTION_KEY=
# External S3-compatible storage for the backups (Backblaze B2: endpoint https://s3.<region>.backblazeb2.com).
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-west-004
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_PREFIX=fieldservice
# true: the app deletes expired backups itself (its key needs delete permission). false: bucket lifecycle rules do.
BACKUP_PRUNE=true
# Scratch database for test restores and restoring one company (default: <DB_DATABASE>_restore).
BACKUP_RESTORE_DATABASE=

# Push notifications on phones (php artisan webpush:keys).
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=

# Server alerts (failed backups) to the platform owner's Telegram while email is not set up (optional).
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Daily watchdog: alert the Owner when records drop by more than this percent or this many in a day.
WATCHDOG_DROP_PERCENT=5
WATCHDOG_DROP_COUNT=10
