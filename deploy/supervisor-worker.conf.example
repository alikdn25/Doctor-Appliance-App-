; /etc/supervisor/conf.d/fieldservice-worker.conf
; Queue worker for SMS, emails, PDFs and reminders (Redis queue).
[program:fieldservice-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/fieldservice/artisan queue:work redis --sleep=3 --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=deploy
numprocs=2
redirect_stderr=true
stdout_logfile=/var/www/fieldservice/storage/logs/worker.log
stopwaitsecs=3600
